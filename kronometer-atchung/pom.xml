        dependency on Kronometer and never will, so the glue lives on this side.</description>

    <dependencies>
        <dependency>
            <groupId>sibarum.kronometer</groupId>
            <artifactId>kronometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.atchung</groupId>
            <artifactId>atchung-core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
